<!DOCTYPE html>
<html>
<head>
    <title>Impossible Button</title>

    <style>
        body {
            text-align: center;
            font-family: Arial;
            background: #f5f5f5;
            overflow: hidden;
        }

        #btn {
            position: absolute;
            padding: 15px 30px;
            font-size: 18px;
            cursor: pointer;
            border: none;
            border-radius: 10px;
            background: purple;
            color: white;
        }
    </style>
</head>

<body>

<h2>😈 Catch Me If You Can!</h2>
<p>Try to click the button...</p>

<button id="btn" onmouseover="moveButton()">
    CLICK ME
</button>

<script>
function moveButton() {
    let btn = document.getElementById("btn");

    let x = Math.random() * (window.innerWidth - 150);
    let y = Math.random() * (window.innerHeight - 100);

    btn.style.left = x + "px";
    btn.style.top = y + "px";
}
</script>

</body>
</html>
