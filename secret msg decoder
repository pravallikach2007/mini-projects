<!DOCTYPE html>
<html>
<head>
    <title>Secret Message Encoder</title>
</head>
<body>

<h2>🔐 Secret Message Encoder</h2>

<input id="msg" placeholder="Enter your message">

<button onclick="encode()">Encode</button>
<button onclick="decode()">Decode</button>

<p id="result"></p>

<script>
function encode() {
    let text = document.getElementById("msg").value;
    let encoded = btoa(text);
    document.getElementById("result").innerText = encoded;
}

function decode() {
    let text = document.getElementById("msg").value;
    let decoded = atob(text);
    document.getElementById("result").innerText = decoded;
}
</script>

</body>
</html>
